# Environment variables example for SubLoop

PORT=3000
NODE_ENV=development

# JWT Secret for authentication
JWT_SECRET=BVjQoB4kyGer2RZ0D

# MongoDB Connection String (Optional: falls back to built-in high performance JSON/In-Memory database store)
MONGODB_URI=mongodb://localhost:27017/subloop

# Admin default setup
ADMIN_EMAIL=admin@subloop.co
ADMIN_PASSWORD=AdminSubLoop2026!

# Client URL for production CORS validation
CLIENT_URL=http://localhost:3000

# Vercel / External Frontend API Base URL (Optional - defaults to relative /api)
VITE_API_URL=
VITE_FIREBASE_AUTH_DOMAIN=sub4sub-two.vercel.app

# Payment Gateway Keys (Modular Abstraction Layer)
PAYMENT_API_KEY=subloop_pay_pk_test_sample123
PAYMENT_SECRET=subloop_pay_sk_test_sample456
PAYMENT_WEBHOOK_SECRET=subloop_whsec_sample789

# Gemini API Key (Server-side AI creator suggestions & anti-abuse audits)
GEMINI_API_KEY=
